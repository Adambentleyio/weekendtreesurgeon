---
import { Image, type ImageMetadata } from "astro:assets";
interface Props { before: ImageMetadata; after: ImageMetadata; beforeAlt: string; afterAlt: string; initialPosition?: number; ariaLabel?: string; }
const { before, after, beforeAlt, afterAlt, initialPosition = 50, ariaLabel = "Move the divider to compare the hedge before and after cutting" } = Astro.props;
---
<div class="comparison" data-before-after style={`--position:${initialPosition}%`}>
  <div class="comparison__image comparison__before">
    <Image src={before} alt={beforeAlt} widths={[640,960,1280]} sizes="(min-width:1120px) 1072px, calc(100vw - 48px)" format="webp" quality={78} loading="lazy" />
    <span class="comparison__label comparison__label--before">Before</span>
  </div>
  <div class="comparison__image comparison__after" aria-hidden="true">
    <Image src={after} alt="" widths={[640,960,1280]} sizes="(min-width:1120px) 1072px, calc(100vw - 48px)" format="webp" quality={78} loading="lazy" />
    <span class="comparison__label comparison__label--after">After</span>
  </div>
  <input class="comparison__range" type="range" min="0" max="100" value={initialPosition} aria-label={ariaLabel} data-comparison-range />
  <div class="comparison__divider" aria-hidden="true"><span class="comparison__handle"><svg viewBox="0 0 28 18"><path d="m9 3-5 6 5 6M19 3l5 6-5 6" /></svg></span></div>
  <p class="sr-only">{afterAlt}</p>
</div>
<script>
  const setupComparisons = () => document.querySelectorAll<HTMLElement>("[data-before-after]").forEach((comparison) => {
    if (comparison.dataset.ready === "true") return;
    const range = comparison.querySelector<HTMLInputElement>("[data-comparison-range]");
    if (!range) return;
    const update = () => comparison.style.setProperty("--position", `${range.value}%`);
    range.addEventListener("input", update); comparison.dataset.ready = "true"; update();
  });
  setupComparisons(); document.addEventListener("astro:page-load", setupComparisons);
</script>
<style lang="less">
  .comparison{--position:50%;position:relative;overflow:hidden;aspect-ratio:4/3;border-radius:var(--radius);background:var(--forest-deep);touch-action:pan-y}
  .comparison__image,.comparison__image :global(picture),.comparison__image :global(img){position:absolute;inset:0;width:100%;height:100%}
  .comparison__image :global(img){object-fit:cover}
  .comparison__before{z-index:1;clip-path:inset(0 calc(100% - var(--position)) 0 0)}
  .comparison__after{z-index:0}
  .comparison__label{position:absolute;top:1rem;z-index:2;padding:.45rem .75rem;border-radius:999px;background:var(--forest-deep);color:var(--white);font-size:.78rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
  .comparison__label--before{right:1rem}.comparison__label--after{left:1rem}
  .comparison__range{position:absolute;inset:0;z-index:4;width:100%;height:100%;margin:0;cursor:ew-resize;opacity:0}
  .comparison__range:focus-visible+.comparison__divider .comparison__handle{outline:3px solid var(--gold);outline-offset:4px}
  .comparison__divider{position:absolute;top:0;bottom:0;left:var(--position);z-index:3;width:3px;background:var(--white);transform:translateX(-50%);pointer-events:none}
  .comparison__handle{position:absolute;top:50%;left:50%;display:grid;width:3.5rem;height:3.5rem;place-items:center;border:3px solid var(--white);border-radius:50%;background:var(--forest);color:var(--white);transform:translate(-50%,-50%)}
  .comparison__handle svg{width:1.75rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:2.25}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:560px){.comparison{aspect-ratio:3/4}.comparison__label{top:.75rem}.comparison__label--before{right:.75rem}.comparison__label--after{left:.75rem}.comparison__handle{width:3rem;height:3rem}}
</style>
