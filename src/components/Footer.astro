---
import client from "../data/client.json";

const { compact = false } = Astro.props;
const year = new Date().getFullYear();
const pageLinks = [
  { label: "Home", href: "/" },
  { label: "About Adam", href: "/about" },
  { label: "Recent work", href: "/recent-work" },
  { label: "Contact", href: "/contact" },
];
const serviceLinks = [
  { label: "Tree removal", href: "/services/tree-removal" },
  { label: "Tree pruning", href: "/services/tree-pruning" },
  { label: "Crown reduction", href: "/services/crown-reduction" },
  { label: "Pollarding", href: "/services/pollarding" },
  { label: "Hedge cutting", href: "/services/hedge-cutting" },
  { label: "Hedge removal", href: "/services/hedge-removal" },
  { label: "Box hedge blight removal", href: "/box-hedge-blight-removal" },
  { label: "Garden maintenance", href: "/services/garden-maintenance" },
];
const serviceArea = client.serviceAreas.slice(0, -1).join(", ");
---

<footer class:list={["site-footer", { "site-footer--compact": compact }]}>
  <div class="page-wrap site-footer__inner">
    {!compact && (
      <section class="site-footer__lead" aria-labelledby="footer-heading">
        <a class="site-footer__brand" href="/" aria-label={`${client.name}, home`}>
          <span aria-hidden="true">WTS</span>
          <small>Weekend Tree Surgeon</small>
        </a>
        <div class="site-footer__invitation">
          <p class="site-footer__eyebrow">Need a hand with your garden?</p>
          <h2 id="footer-heading">Tell Adam what needs doing.</h2>
          <p>Share a few details about the job and Adam will get back to you personally.</p>
        </div>
        <div class="site-footer__actions">
          <a class="site-footer__button" href="/contact">Request a quote <span aria-hidden="true">→</span></a>
          <a class="site-footer__phone" href={`tel:${client.phoneForTel}`}>
            <span>Prefer to call?</span>
            {client.phoneFormatted}
          </a>
        </div>
      </section>
    )}

    <div class="site-footer__directory">
      <nav aria-label="Footer navigation">
        <h2>Explore</h2>
        <ul>{pageLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>

      <nav class="site-footer__services" aria-label="Services">
        <h2>Services</h2>
        <ul>{serviceLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>

      <div class="site-footer__local">
        <h2>Local to Cheshire</h2>
        <p>Working in {serviceArea} and nearby villages.</p>
        <a href={client.googleBusinessUrl}>View on Google <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="site-footer__base">
      <p>Good work for good people.</p>
      <p>© {year} {client.name}</p>
    </div>
  </div>
</footer>

<style lang="less">
  .site-footer { padding-block: clamp(3.5rem, 8vw, 6.5rem) 1.5rem; background: var(--forest-deep); color: #dce7df; }
  .site-footer--compact { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .site-footer__inner { display: grid; gap: clamp(3rem, 7vw, 5.5rem); }
  .site-footer--compact .site-footer__inner { gap: clamp(2rem, 4vw, 3rem); }
  .site-footer__lead { display: grid; gap: 2rem; padding: 0 0 clamp(2.75rem, 6vw, 4.5rem); border-bottom: 1px solid rgba(255, 255, 255, .16); }
  .site-footer__brand { display: inline-flex; width: fit-content; align-items: center; gap: .75rem; color: var(--white); text-decoration: none; }
  .site-footer__brand span { color: #d9a45d; font-family: "Press Start 2P", monospace; font-size: 1.1rem; letter-spacing: -.05em; }
  .site-footer__brand small { max-width: 10rem; color: #bdd0c1; font-size: .72rem; font-weight: 700; letter-spacing: .035em; line-height: 1.3; }
  .site-footer__eyebrow { margin-bottom: .75rem; color: #bfd2c2; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .site-footer__invitation h2 { max-width: 13ch; color: var(--white); font-size: clamp(2rem, 7vw, 4rem); line-height: 1; letter-spacing: -.035em; }
  .site-footer__invitation > p:last-child { max-width: 35rem; margin-top: 1rem; color: #c6d5ca; }
  .site-footer__actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  .site-footer__button { display: inline-flex; min-height: 3.35rem; align-items: center; justify-content: center; gap: .75rem; padding: .85rem 1.2rem; border-radius: .75rem; background: var(--gold); color: var(--forest-deep); font-weight: 700; text-decoration: none; transition: background-color 180ms ease, transform 180ms ease; }
  .site-footer__button:hover { background: #dda35b; transform: translateY(-2px); }
  .site-footer__button span { font-size: 1.2em; }
  .site-footer__phone { display: grid; gap: .1rem; color: var(--white); font-size: 1.12rem; font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: .25rem; }
  .site-footer__phone span { color: #9eb5a4; font-size: .76rem; font-weight: 600; }
  .site-footer__directory { display: grid; gap: 2.5rem; }
  .site-footer__directory h2 { margin-bottom: 1.15rem; color: var(--white); font-size: 1rem; }
  .site-footer__directory ul { display: grid; gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .site-footer__directory a { color: #cfdbd2; text-underline-offset: .25rem; transition: color 160ms ease; }
  .site-footer__directory a:hover { color: var(--white); }
  .site-footer__services ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.25rem; }
  .site-footer__local p { max-width: 27rem; color: #b8cabc; }
  .site-footer__local a { display: block; width: fit-content; margin-top: .9rem; overflow-wrap: anywhere; }
  .site-footer__base { display: flex; flex-direction: column; gap: .4rem; padding-top: 1.35rem; border-top: 1px solid rgba(255, 255, 255, .16); color: #98afa0; font-size: .78rem; }

  @media (min-width: 700px) {
    .site-footer__lead { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    .site-footer__brand { grid-column: 1 / -1; }
    .site-footer__actions { align-items: flex-end; }
    .site-footer__directory { grid-template-columns: .7fr 1.3fr 1.15fr; gap: clamp(2rem, 5vw, 5rem); }
    .site-footer__base { flex-direction: row; justify-content: space-between; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__button, .site-footer__directory a { transition: none; }
    .site-footer__button:hover { transform: none; }
  }
</style>
