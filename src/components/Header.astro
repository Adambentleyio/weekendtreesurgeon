---
import DarkModeToggle from "./DarkModeToggle.astro";
import '@fontsource/press-start-2p';
---

<!-- ============================================ --><!--                 Navigation                   --><!-- ============================================ -->
<header id="cs-navigation">
  <div class="cs-container">
    <!--Nav Logo-->
    <a href="/" class="cs-logo" aria-label="Weekend Tree Surgeon, back to home">
      <span class="text-logo">WTS</span>
    </a>
    <!--Dark Mode toggle-->
    <DarkModeToggle />
    <!--Single call-to-action-->
    <a href="/contact" class="cs-button-solid">Contact</a>
  </div>
</header>

<style lang="less">
  #cs-navigation {
    background-color: var(--color-warm-linen);
    border-bottom: 1px solid var(--color-hedgerow);

    .cs-container {
      width: 100%;
      max-width: (1280/16rem);
      margin: auto;
      padding: 0 (16/16rem);
      height: (65/16rem);
      display: flex;
      align-items: center;
      gap: (16/16rem);
    }

    .cs-logo {
      display: flex;
      align-items: center;
      margin-right: auto;
      text-decoration: none;

      .text-logo {
        font-family: "Press Start 2P", monospace;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.05em;
        text-transform: uppercase;
        color: var(--primary);
      }
    }
  }

  body.dark-mode {
    #cs-navigation {
      background-color: var(--dark);
      border-bottom-color: var(--medium);
    }
  }
</style>
