---
import "@fontsource/press-start-2p/latin-400.css";
import client from "../data/client.json";

interface Props {
  ctaHref?: string;
}

const { ctaHref = "/contact" } = Astro.props;

const serviceLinks = [
  { label: "Hedge cutting", href: "/hedge-cutting" },
  { label: "Tree removal", href: "/dead-tree-removal" },
  { label: "Hedge removal", href: "/hedge-removal" },
  { label: "Garden maintenance", href: "/garden-maintenance" },
];

const links = [
  { label: "Recent work", href: "/#recent-work" },
  { label: "About", href: "/#about" },
];
---

<header class="site-header" data-site-header>
  <nav class="site-nav page-wrap" aria-label="Main navigation">
    <a class="site-nav__logo" href="/" aria-label="Weekend Tree Surgeon, home">
      <span aria-hidden="true">WTS</span>
      <small aria-hidden="true">everyday</small>
    </a>

    <div class="site-nav__desktop-links">
      <details class="site-nav__services">
        <summary>
          Services
          <svg aria-hidden="true" viewBox="0 0 12 8" fill="none">
            <path d="m1 1.5 5 5 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="site-nav__dropdown">
          {serviceLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
        </div>
      </details>
      {links.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>

    <a class="site-nav__cta" href={ctaHref}>
      <span class="site-nav__cta-long">Get in touch&nbsp; →</span>
      <span class="site-nav__cta-short">Get in touch</span>
    </a>

    <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav-menu" aria-label="Open navigation menu">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>

    <div class="site-nav__mobile-menu" id="site-nav-menu" hidden>
      <details class="site-nav__mobile-services">
        <summary>Services</summary>
        <div>
          {serviceLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
        </div>
      </details>
    </div>

    <div class="site-nav__quick-links" aria-label="Quick links">
      {links.map(({ label, href }) => <a href={href}>{label}</a>)}
      <a href={`tel:${client.phoneForTel}`} aria-label={`Prefer to call? Call ${client.phoneFormatted}`}>Prefer to call?</a>
    </div>
  </nav>
</header>

<script>
  const setupSiteNavigation = () => {
    document.querySelectorAll<HTMLElement>("[data-site-header]").forEach((header) => {
      if (header.dataset.navigationReady === "true") return;

      const toggle = header.querySelector<HTMLButtonElement>(".site-nav__toggle");
      const menu = header.querySelector<HTMLElement>(".site-nav__mobile-menu");
      if (!toggle || !menu) return;

      const closeMenu = () => {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open navigation menu");
        menu.hidden = true;
      };

      closeMenu();
      toggle.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        toggle.setAttribute("aria-label", isOpen ? "Open navigation menu" : "Close navigation menu");
        menu.hidden = isOpen;
      });

      menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
      header.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          closeMenu();
          toggle.focus();
        }
      });

      header.dataset.navigationReady = "true";
    });
  };

  setupSiteNavigation();
  document.addEventListener("astro:page-load", setupSiteNavigation);
</script>

<style lang="less">
  .site-header { position: relative; z-index: 20; border-bottom: 1px solid var(--line); background: var(--cream); }
  .site-nav { position: relative; display: flex; min-height: 4.5rem; flex-wrap: wrap; align-items: center; gap: 0 .75rem; padding-top: .35rem; }
  .site-nav__logo { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .55rem; margin-right: auto; color: var(--forest); font-family: "Press Start 2P", monospace; font-size: 1rem; font-weight: 700; letter-spacing: -.05em; line-height: 1; text-decoration: none; }
  .site-nav__logo span, .site-nav__logo small { display: block; }
  .site-nav__logo small { color: var(--sage); font-family: var(--font-body); font-size: .68rem; font-weight: 700; letter-spacing: .04em; line-height: 1; text-transform: lowercase; }
  .site-nav__desktop-links { display: none; }
  .site-nav__cta { display: inline-flex; min-height: 2.65rem; align-items: center; justify-content: center; padding: .6rem .85rem; border-radius: .7rem; background: var(--gold); color: var(--forest-deep); font-size: .82rem; font-weight: 700; line-height: 1; text-decoration: none; transition: background-color 160ms ease, transform 160ms ease; }
  .site-nav__cta:hover { background: #dda35b; transform: translateY(-1px); }
  .site-nav__cta-long { display: none; }
  .site-nav__toggle { display: grid; width: 2.75rem; height: 2.75rem; place-content: center; gap: .27rem; padding: 0; border: 1px solid var(--line); border-radius: .7rem; background: transparent; color: var(--forest); }
  .site-nav__toggle span { width: 1.15rem; height: 2px; border-radius: 2px; background: currentColor; }
  .site-nav__mobile-menu { position: absolute; top: calc(100% + 1px); right: var(--page-padding); left: var(--page-padding); display: grid; grid-template-rows: 0fr; overflow: hidden; border-radius: 0 0 .9rem .9rem; background: var(--cream); transition: grid-template-rows 200ms cubic-bezier(.22, 1, .36, 1), padding 200ms cubic-bezier(.22, 1, .36, 1); }
  .site-nav__toggle[aria-expanded="true"] + .site-nav__mobile-menu { grid-template-rows: auto; padding-block: .5rem; border: 1px solid var(--line); border-top: 0; }
  .site-nav__mobile-services { min-height: 0; overflow: hidden; color: var(--forest); }
  .site-nav__mobile-services summary { display: flex; min-height: 3rem; align-items: center; justify-content: space-between; padding-inline: 1rem; font-weight: 700; cursor: pointer; list-style: none; }
  .site-nav__mobile-services summary::-webkit-details-marker { display: none; }
  .site-nav__mobile-services summary::after { content: "+"; color: var(--gold); font-size: 1.35rem; font-weight: 500; }
  .site-nav__mobile-services[open] summary::after { content: "−"; }
  .site-nav__mobile-services div { display: grid; padding: .15rem .75rem .65rem; }
  .site-nav__mobile-services a { padding: .65rem .75rem; border-radius: .5rem; color: var(--forest); font-size: .92rem; font-weight: 600; text-decoration: none; }
  .site-nav__quick-links { display: grid; width: 100%; grid-template-columns: 1.2fr .75fr 1.15fr; border-top: 1px solid var(--line); }
  .site-nav__quick-links a { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; color: var(--forest); font-size: clamp(.72rem, 3.2vw, .84rem); font-weight: 600; line-height: 1.1; text-align: center; text-decoration: none; }
  .site-nav__quick-links a + a { border-left: 1px solid var(--line); }
  .site-nav__quick-links a:last-child { color: var(--forest-deep); }
  .site-nav__quick-links a:hover { background: var(--sage-light); }

  @media (min-width: 768px) {
    .site-nav { min-height: 4.75rem; flex-wrap: nowrap; gap: clamp(1.5rem, 3vw, 2.5rem); padding-top: 0; }
    .site-nav__desktop-links { display: flex; align-items: center; gap: clamp(1.25rem, 2.5vw, 2.25rem); }
    .site-nav__desktop-links > a { position: relative; display: inline-flex; min-height: 2.9rem; align-items: center; color: var(--forest); font-size: .94rem; font-weight: 600; line-height: 1; text-decoration: none; }
    .site-nav__desktop-links > a::after { content: ""; position: absolute; right: 0; bottom: .2rem; left: 0; height: 2px; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 180ms cubic-bezier(.22, 1, .36, 1); }
    .site-nav__desktop-links > a:hover::after, .site-nav__desktop-links > a:focus-visible::after { transform: scaleX(1); }
    .site-nav__services { position: relative; display: flex; align-items: center; }
    .site-nav__services summary { display: flex; min-height: 2.9rem; align-items: center; gap: .35rem; color: var(--forest); font-size: .94rem; font-weight: 600; line-height: 1; cursor: pointer; list-style: none; }
    .site-nav__services summary::-webkit-details-marker { display: none; }
    .site-nav__services summary svg { width: .7rem; height: .5rem; flex: none; color: var(--gold); transition: transform 180ms cubic-bezier(.22, 1, .36, 1); }
    .site-nav__services[open] summary svg { transform: rotate(180deg); }
    .site-nav__dropdown { position: absolute; top: calc(100% + .7rem); left: -.85rem; display: grid; width: 14rem; padding: .55rem; border: 1px solid var(--line); border-radius: .8rem; background: var(--cream); }
    .site-nav__dropdown::before { content: ""; position: absolute; right: 0; bottom: 100%; left: 0; height: .8rem; }
    .site-nav__dropdown a { padding: .7rem .75rem; border-radius: .5rem; color: var(--forest); font-size: .92rem; font-weight: 600; line-height: 1.35; text-decoration: none; }
    .site-nav__dropdown a:hover { background: var(--sage-light); }
    .site-nav__services:not([open]) .site-nav__dropdown { display: none; }
    .site-nav__cta { min-height: 2.9rem; padding-inline: 1.15rem; font-size: .9rem; }
    .site-nav__cta-long { display: inline; }
    .site-nav__cta-short, .site-nav__toggle, .site-nav__mobile-menu, .site-nav__quick-links { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__cta, .site-nav__desktop-links a::after, .site-nav__mobile-menu, .site-nav__services summary svg { transition: none; }
    .site-nav__cta:hover { transform: none; }
  }
</style>
