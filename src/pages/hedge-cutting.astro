---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import Footer from "../components/Footer.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import client from "../data/client.json";
import heroImage from "../assets/images/hedge-willaston/hedge-willaston-after-3.jpg";
import beforeImage from "../assets/images/hedge-willaston/hedge-willaston-before-1.jpg";
import afterImage from "../assets/images/hedge-willaston/hedge-willaston-after-1.jpg";
import beforeCorner from "../assets/images/hedge-willaston/hedge-willaston-before-close-corner.jpg";
import duringOne from "../assets/images/hedge-willaston/hedge-willaston-during-1.jpg";
import duringTwo from "../assets/images/hedge-willaston/hedge-willaston-during-2.jpg";
import afterTwo from "../assets/images/hedge-willaston/hedge-willaston-after-2.jpg";
import afterThree from "../assets/images/hedge-willaston/hedge-willaston-after-3.jpg";

const project = {
  label: "Recent project",
  title: "Bringing an overgrown Willaston hedge back into shape",
  problem: "This established boundary hedge had become broad and uneven, taking up more of the garden and losing its clean outline.",
  work: "The sides and top were carefully cut back to restore a more balanced shape, with attention paid to the adjoining fence.",
  outcome: "The finished hedge has a neater profile and the garden edge feels clearer and easier to maintain.",
  details: [
    ["Location", "Willaston, Cheshire", "pin"],
    ["Work carried out", "Hedge cut back and reshaped", "shears"],
    ["Time on site", "To be confirmed", "clock"],
    ["Outcome", "A tidier, more even boundary", "leaf"],
  ],
};
const gallery = [
  { src: beforeCorner, alt: "Dense hedge growth around the garden corner before cutting" },
  { src: duringOne, alt: "Hedge cutting in progress beside the garden boundary in Willaston" },
  { src: duringTwo, alt: "Cut branches being cleared while the Willaston hedge is reshaped" },
  { src: afterTwo, alt: "The finished boundary hedge with a neat, even side and top" },
  { src: afterThree, alt: "The finished boundary hedge with a neat, even side and top" },
];
---
<BaseLayout title="Hedge Cutting in Nantwich and Cheshire" description="Local hedge cutting in Nantwich, Crewe and nearby Cheshire villages. See a genuine Willaston project and ask Weekend Tree Surgeon for a free quote." showNav={true} navCtaHref="#get-in-touch">
  <article class="service-page">
    <section class="service-hero" aria-labelledby="service-title">
      <Image class="service-hero__image" src={heroImage} alt="A freshly cut boundary hedge in a Willaston garden" widths={[768,1280,1920]} sizes="100vw" format="avif" quality={80} loading="eager" />
      <div class="service-hero__shade" aria-hidden="true"></div>
      <div class="page-wrap service-hero__inner"><div class="service-hero__copy">
        <p class="section-label">Local hedge care</p>
        <h1 id="service-title">Hedge cutting in Nantwich and across Cheshire</h1>
        <p class="service-hero__subtitle">Neat, healthy hedges that look great and keep your garden in shape.</p>
        <ul class="service-hero__benefits"><li>Tidy, well-shaped hedges</li><li>Improved light and space</li><li>All green waste removed, where included in the quote</li></ul>
        <div class="service-hero__actions"><a class="service-button service-button--primary" href="/contact">Get a free quote</a><a class="service-button service-button--secondary" href="#recent-project">View our work</a></div>
      </div></div>
    </section>

    <section class="project page-wrap" id="recent-project" aria-labelledby="project-title">
      <div class="project__story"><p class="section-label">{project.label}</p><h2 id="project-title">{project.title}</h2>
        <div class="project__narrative"><div><h3>The problem</h3><p>{project.problem}</p></div><div><h3>What we did</h3><p>{project.work}</p></div><div><h3>The outcome</h3><p>{project.outcome}</p></div></div>
      </div>
      <aside class="project-details" aria-label="Project details"><p class="project-details__heading">At a glance</p><dl>{project.details.map(([label,value,icon]) => <div><dt><span class={`project-details__icon project-details__icon--${icon}`} aria-hidden="true"></span>{label}</dt><dd>{value}</dd></div>)}</dl></aside>
    </section>

    <section class="comparison-section"><div class="page-wrap">
      <div class="section-heading"><p class="section-label">Before and after</p><h2>Drag to see the difference</h2><p>Move the handle across the image, or focus it and use your arrow keys.</p></div>
      <BeforeAfterSlider before={beforeImage} after={afterImage} beforeAlt="The broad, uneven Willaston boundary hedge before cutting" afterAlt="The same Willaston boundary hedge after it was cut back and reshaped" />
    </div></section>

    <section class="gallery-section page-wrap" aria-labelledby="gallery-title"><div class="section-heading"><p class="section-label">The work up close</p><h2 id="gallery-title">From first cut to final clear-up</h2><p>Genuine photographs from the same Willaston hedge-cutting project.</p></div><ProjectGallery images={gallery} /></section>

    <section class="quote-band" id="get-in-touch" aria-labelledby="quote-title"><div class="page-wrap quote-band__inner"><div><p class="section-label">Your hedge next</p><h2 id="quote-title">Tell Adam what needs tidying up</h2><p>Send a few details and photos for a straightforward, no-obligation quote.</p></div><div class="quote-band__actions"><a class="service-button service-button--light" href="/contact">Get a free quote</a><a class="quote-band__phone" href={`tel:${client.phoneForTel}`}>Or call {client.phoneFormatted}</a></div></div></section>
  </article>
  <Footer />
</BaseLayout>

<style lang="less">
  .service-page{background:var(--cream)}
  .service-hero{position:relative;display:grid;min-height:clamp(39rem,78vh,49rem);align-items:end;padding-block:0;isolation:isolate}.service-hero__image,.service-hero__shade{position:absolute;inset:0;width:100%;height:100%}.service-hero__image{z-index:-2;object-fit:cover;object-position:58% center}.service-hero__shade{z-index:-1;background:linear-gradient(90deg,rgba(10,27,19,.93) 0%,rgba(10,27,19,.74) 46%,rgba(10,27,19,.16) 78%)}
  .service-hero__inner{width:100%;padding-block:clamp(4rem,10vw,7rem)}.service-hero__copy{max-width:43rem;color:var(--white)}.service-hero .section-label{color:#c8dfc8}.service-hero h1{max-width:14ch;color:var(--white);font-size:clamp(2.5rem,6vw,4.8rem);line-height:1.02}.service-hero__subtitle{max-width:39rem;margin-top:1.25rem;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.5}.service-hero__benefits{display:grid;gap:.6rem;margin:1.5rem 0 0;padding:0;list-style:none}.service-hero__benefits li{position:relative;padding-left:1.65rem}.service-hero__benefits li::before{content:"";position:absolute;top:.55em;left:0;width:.7rem;height:.4rem;border-bottom:2px solid #c8dfc8;border-left:2px solid #c8dfc8;transform:rotate(-45deg)}
  .service-hero__actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.service-button{display:inline-flex;min-height:3.25rem;align-items:center;justify-content:center;padding:.75rem 1.35rem;border:2px solid transparent;border-radius:.75rem;font-weight:700;line-height:1.2;text-decoration:none;transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,transform 180ms ease}.service-button:hover{transform:translateY(-2px)}.service-button--primary{background:var(--gold);color:var(--forest-deep)}.service-button--primary:hover{background:#dda35b}.service-button--secondary{border-color:rgba(255,255,255,.75);color:var(--white)}.service-button--secondary:hover{background:var(--white);color:var(--forest-deep)}
  .project{display:grid;gap:clamp(2.5rem,7vw,6rem);padding-block:var(--section-space)}.project__story{max-width:44rem}.project__story h2{max-width:20ch;margin-bottom:2rem;font-size:clamp(1.9rem,4vw,3rem)}.project__narrative{display:grid;gap:1.5rem}.project__narrative h3{margin-bottom:.35rem;font-size:1rem}.project__narrative p{max-width:64ch;color:var(--charcoal-soft)}
  .project-details{align-self:start;padding:clamp(1.5rem,4vw,2.25rem);border-radius:var(--radius);background:var(--forest);color:var(--white)}.project-details__heading{margin-bottom:.75rem;font-family:var(--font-heading);font-size:1.35rem;font-weight:700}.project-details dl{margin:0}.project-details dl>div{padding-block:1rem;border-top:1px solid rgba(255,255,255,.18)}.project-details dt{display:flex;align-items:center;gap:.6rem;color:#d9e7da;font-size:.78rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.project-details dd{margin:.25rem 0 0 1.6rem;font-weight:600}.project-details__icon{position:relative;display:inline-block;width:1rem;height:1rem;border:1.5px solid currentColor;border-radius:50%}.project-details__icon--clock::after{content:"";position:absolute;top:.18rem;left:.45rem;width:.22rem;height:.35rem;border-left:1.5px solid currentColor;border-bottom:1.5px solid currentColor}.project-details__icon--leaf{border-radius:100% 0 100% 0;transform:rotate(-15deg)}.project-details__icon--shears::before,.project-details__icon--shears::after{content:"";position:absolute;width:.6rem;height:1px;top:.42rem;left:.18rem;background:currentColor;transform:rotate(42deg)}.project-details__icon--shears::after{transform:rotate(-42deg)}
  .comparison-section{padding-block:var(--section-space);background:var(--sage-lighter)}.section-heading{max-width:42rem;margin-bottom:clamp(1.75rem,4vw,2.75rem)}.section-heading h2{margin-bottom:.65rem;font-size:clamp(1.9rem,4vw,3rem)}.section-heading>p:last-child{color:var(--charcoal-soft)}.gallery-section{padding-block:var(--section-space)}
  .quote-band{padding-block:clamp(3.5rem,7vw,5.5rem);background:var(--forest-deep);color:var(--white)}.quote-band__inner{display:grid;gap:2rem;align-items:center}.quote-band .section-label{color:#b9d3bd}.quote-band h2{max-width:18ch;margin-bottom:.75rem;color:var(--white);font-size:clamp(1.8rem,4vw,2.8rem)}.quote-band p:last-child{max-width:56ch;color:#dce7df}.quote-band__actions{display:flex;flex-direction:column;align-items:flex-start;gap:1rem}.service-button--light{background:var(--white);color:var(--forest-deep)}.service-button--light:hover{background:var(--sage-light)}.quote-band__phone{color:var(--white);font-weight:700;text-underline-offset:.25rem}
  @media(min-width:800px){.project{grid-template-columns:minmax(0,1.35fr) minmax(18rem,.75fr);align-items:start}.quote-band__inner{grid-template-columns:minmax(0,1fr) auto}.quote-band__actions{align-items:flex-end}}
  @media(max-width:620px){.service-hero{min-height:44rem}.service-hero__image{object-position:62% center}.service-hero__shade{background:linear-gradient(0deg,rgba(10,27,19,.96) 0%,rgba(10,27,19,.8) 58%,rgba(10,27,19,.22) 100%)}.service-hero__inner{padding-block:3.5rem}.service-hero h1{font-size:clamp(2.35rem,11vw,3.4rem)}.service-hero__actions{align-items:stretch;flex-direction:column}.service-button{width:100%}}
  @media(prefers-reduced-motion:reduce){.service-button{transition:none}.service-button:hover{transform:none}}
</style>
