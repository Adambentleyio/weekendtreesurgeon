---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, Picture } from "astro:assets";
import founderPhoto from "../assets/images/founder-headshot.webp";
import adamProfile from "../assets/images/adam-profile.jpg";
import climbingPhoto from "../assets/images/dismantle.jpg";
import leightonAfter from "../assets/images/dead-tree-removal-leighton-crewe/eucalyptus-removal-leighton-after.jpg";
import willastonAfter from "../assets/images/hedge-cutting-willaston/hedge-willaston-after-1.jpg";
import stapeleyAfter from "../assets/images/box-hedge-blight-nantwich/IMG_9325.JPG";
import client from "../data/client.json";

const recentProjects = [
  { title: "Dead eucalyptus removed", service: "Tree removal", location: "Leighton, Crewe", outcome: "The dead tree and stump were removed, leaving a safer, more open garden.", href: "/dead-tree-removal", linkLabel: "See the Leighton tree removal", image: leightonAfter, alt: "Leighton garden after a dead eucalyptus tree and its stump were removed" },
  { title: "Overgrown hedge cut back", service: "Hedge cutting", location: "Willaston", outcome: "A neater boundary, more light and a hedge brought back under control.", href: "/hedge-cutting", linkLabel: "See the Willaston hedge cutting", image: willastonAfter, alt: "Tall boundary hedge in Willaston after being cut back and shaped" },
  { title: "Diseased box hedge replaced", service: "Box hedge removal", location: "Stapeley", outcome: "The failed box was removed and the border replanted for a fresh start.", href: "/box-hedge-removal", linkLabel: "See the Stapeley hedge replacement", image: stapeleyAfter, alt: "Stapeley border replanted after a diseased box hedge was removed" },
];
---

<BaseLayout
  title="Tree Surgery in Nantwich & Crewe"
  description="Professional tree surgery and hedge cutting for homeowners in Nantwich, Crewe and surrounding Cheshire areas."
  showNav="true"
  >
<section class="hero" id="hero">
  <div class="hero__inner">
    <div class="hero__content">
      <div class="hero__intro">
        <Image class="hero__photo" src={adamProfile} alt="Adam Bentley, the Weekend Tree Surgeon" width={96} height={96} format="webp" quality={82} loading="eager" />
        <p class="hero__greeting">
          Hi, I’m Adam
          <span>Wistaston and Nantwich-based Tree Surgeon</span>
        </p>
      </div>

      <h1 class="hero__title">Your garden, cared for properly.</h1>

      <div class="hero-reviews" aria-label="Recent customer reviews on Google">
        <div class="hero-reviews__heading">
          <span class="hero-reviews__stars" aria-label="5 out of 5 stars">★★★★★</span>
          <a href={client.googleBusinessUrl}>Real words from customers on Google <span aria-hidden="true">↗</span></a>
        </div>
        <blockquote class="hero-reviews__lead">
          <p>“Thanks Adam. 5 stars is not enough, you deserve a gold star.”</p>
        </blockquote>
      </div>

      <form name="hero-quote" method="POST" data-netlify="true" class="quote-card hero__quote">
        <input type="hidden" name="form-name" value="hero-quote" />
        <div class="quote-card__row">
          <input id="hero-phone" type="tel" name="phone" inputmode="tel" placeholder="Your mobile number" autocomplete="tel" aria-label="Your mobile number" required>
          <button type="submit" class="quote-card__btn">Request a quote</button>
        </div>
        <p class="hero__contact-options">
          Rather talk? <a href={`tel:${client.phoneForTel}`}>Call {client.phoneFormatted}</a>
          <span aria-hidden="true">·</span>
          <a href="/contact">Tell me about the job</a>
        </p>
      </form>
    </div>
    <div class="hero__media">
      <Picture
        src={climbingPhoto}
        formats={["avif", "webp"]}
        widths={[480, 720, 960]}
        sizes="(min-width: 1200px) 34vw, (min-width: 768px) 38vw, 100vw"
        alt="Adam working from ropes while reducing a tree in a Cheshire garden"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

  <section class="recent-work" id="recent-work" aria-labelledby="recent-work-title">
    <div class="page-wrap">
      <span class="section-label">Recent work around Cheshire</span>
      <h2 id="recent-work-title">See the problem, the work and how the garden was left.</h2>
      <div class="recent-work__grid">
        {recentProjects.map((project, index) => (
          <article class:list={["project-card", { "project-card--featured": index === 0 }]}>
            <a class="project-card__image" href={project.href} aria-label={project.linkLabel}>
              <Image src={project.image} alt={project.alt} widths={[480, 768, 1120]} sizes={index === 0 ? "(min-width: 768px) 55vw, 100vw" : "(min-width: 768px) 35vw, 100vw"} format="avif" quality={78} loading="lazy" />
            </a>
            <div class="project-card__body">
              <p class="project-card__meta">{project.service} <span aria-hidden="true">·</span> {project.location}</p>
              <h3>{project.title}</h3>
              <p>{project.outcome}</p>
              <a class="project-card__link" href={project.href}>{project.linkLabel} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <div class="recent-work__actions">
        <a class="recent-work__primary" href="/contact">Get a quote for your garden</a>
        <a class="recent-work__secondary" href="#services">See all services</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="services">
    <div class="page-wrap">
      <span class="section-label">How I can help</span>
      <h2>Tree work without the usual hassle.</h2>

      <nav class="service-list" aria-label="Tree and garden services">
        <a href="/hedge-cutting"><span>Hedge cutting</span><small>Trim, shape or reduce overgrown hedges</small><b aria-hidden="true">→</b></a>
        <a href="/dead-tree-removal"><span>Tree removal</span><small>Careful dismantling and stump removal</small><b aria-hidden="true">→</b></a>
        <a href="/hedge-removal"><span>Hedge removal</span><small>Remove unwanted hedges and reclaim space</small><b aria-hidden="true">→</b></a>
        <a href="/garden-maintenance"><span>Garden maintenance</span><small>Tidy established gardens back into shape</small><b aria-hidden="true">→</b></a>
      </nav>
    </div>
  </section>

  <!-- Gallery -->
  <!-- <section class="gallery">
    <div class="page-wrap">
      <span class="section-label">Real work</span>
      <h2>Good work, properly finished.</h2>

      <div class="gallery-grid">
        <Picture
          src={hedges}
          formats={["avif", "webp"]}
          alt="Neatly trimmed hedge in a Cheshire garden"
          loading="lazy"
        />

        <Picture
          src={dismantle}
          formats={["avif", "webp"]}
          alt="Tree sections after careful dismantling"
          loading="lazy"
        />

        <Picture
          src={clearanceBefore}
          formats={["avif", "webp"]}
          alt="Overgrown garden before clearance"
          loading="lazy"
        />

        <Picture
          src={clearanceAfter}
          formats={["avif", "webp"]}
          alt="Garden after tree and hedge clearance"
          loading="lazy"
        />

        <Picture
          src={climbing}
          formats={["avif", "webp"]}
          alt="Tree climbing work in progress"
          loading="lazy"
        />

        <Picture
          src={ffintree}
          formats={["avif", "webp"]}
          alt="Tree felling work in progress"
          loading="lazy"
        />

        <Picture
          src={log}
          formats={["avif", "webp"]}
          alt="Cut logs ready for removal"
          loading="lazy"
        />

        <Picture
          src={garden}
          formats={["avif", "webp"]}
          alt="Garden clearance work in progress"
          loading="lazy"
        />
      </div>
    </div>
  </section> -->

  <!-- Founder -->
  <section class="founder about" id="about">
    <!-- place as the first children inside your about/founder section, before the content wrapper -->
    <svg class="about__canopy" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="150" cy="120" r="130" fill="#2E5240" opacity="0.55"/>
      <circle cx="210" cy="80" r="80" fill="#3C6B4F" opacity="0.45"/>
      <circle cx="90" cy="60" r="70" fill="var(--sage)" opacity="0.25"/>
    </svg>
    <svg class="about__canopy-secondary" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="100" cy="100" r="95" fill="var(--gold)" opacity="0.12"/>
    </svg>
    <!-- Founder markup -->
    <div class="page-wrap">
      <span class="section-label">Who's actually showing up</span>
      <h2>A real person, accountable for the work.</h2>

        <Image
          src={founderPhoto}
          class="founder-photo"
          alt="Adam, founder of Weekend Tree Surgeon"
          width={260}
          height={260}
          format="webp"
          quality={80}
        />

      <h3>Adam</h3>
      <p class="founder-role">Lead Tree Guy, Weekend Tree Surgeon</p>

      <p>
        I'm a masters graduate and former "white-collar" knowledge worker. I like solving
        problems properly, paying attention to detail and doing what I said
        I'd do.
      </p>

      <p>
        I'm also a father, bodybuilder and self-development writer. Those
        things have shaped how I think about discipline, responsibility and
        treating people well.
      </p>

      <p>
        My aim is simple: to build the kindest, highest-agency life I can —
        and bring that same standard of care to the people who trust me with
        their homes.
      </p>

      <div class="trait-list" aria-label="About the founder">
        <span>Father</span>
        <span>Masters of Science</span>
        <span>Bodybuilder</span>
        <span>Self-Development Writer</span>
      </div>

      <a href="https://smaller-stronger-shredded.netlify.app" class="blog-link">My work outside of trees →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="page-wrap">
      <span class="section-label">Good questions</span>
      <h2>Let's remove the awkward bits.</h2>

      <div class="faq-list">
        <details>
          <summary>Where do you operate?</summary>
          <p>
            I started WTS to help friends and family look after their gardens, working as far as Sandbach and whithchurch, and everywhere in between. If you're within 25 miles of Crewe we're off to a good start.
          </p>
        </details>
        <details>
          <summary>Are you going to ghost me after giving a quote?</summary>
          <p>
            No. If I give you a quote, I'll tell you what happens next and
            keep you updated rather than leaving you wondering.
          </p>
        </details>

        <details>
          <summary>Will my garden look like a war zone when you leave?</summary>
          <p>
            Not at all. Careful work and proper cleanup are part of the job, not an
            optional extra. If there's going to be any "collateral damage" then we'll talk about it first. 
          </p>
        </details>

        <details>
  <summary>My box hedge has caterpillar damage — is it worth saving?</summary>
  <p>
    Usually not, unfortunately. Most UK box hedges with visible caterpillar
    damage have box tree moth caterpillars, and once a hedge is badly
    infested or box blight sets in alongside it, full recovery is rare. We'll
    inspect it honestly and tell you straight whether it's worth treating or
    better to remove and replace with a hardier look-alike like Ilex crenata
    — no point charging you to save something that won't make it.
  </p>
</details>

<details>
  <summary>When's the best time of year to trim my hedge or tree?</summary>
  <p>
    For most hedges, late summer to winter (roughly August to February)
    avoids the UK's bird nesting season, when it's a legal offence to
    disturb an active nest. Deciduous trees are usually best pruned while
    dormant in winter. The right timing does vary by species though, so we
    always check what's actually in your garden before booking the work in,
    rather than working to a single fixed date.
  </p>
</details>

<details>
  <summary>Do I need a Tree Preservation Order (TPO) application before you start?</summary>
  <p>
    Sometimes — it depends on the tree and whether your property sits in a
    conservation area. A Tree Preservation Order protects specific trees,
    and working on one without council consent can mean a serious fine. We
    check your address against the local TPO register as a standard part of
    every quote, so you're never left to figure that paperwork out yourself.
  </p>
</details>

        <details>
          <summary>Do I have to stay home all day waiting for you?</summary>
          <p>
            No. I'll agree a clear arrival window with you so you know when
            to expect me.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Guarantee -->
<section class="guarantee" id="get-in-touch">
  <div class="page-wrap">
    <span class="guarantee-label">The "No-Mess" Guarantee</span>

    <h2>If I leave a mess behind, I'll come back and sort it.</h2>

    <p>
      Find a mess we left behind? We'll drive back, clean it, and knock £10
      off your bill.
    </p>

    <div class="quote-card">
      <span class="section-label">Ready when you are</span>
      <h2>Tell me where to reach you.</h2>

      <form name="guarantee-quote" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="guarantee-quote" />
        <p class="quote-card__label">
          <label for="footer-phone">Mobile number</label>
        </p>
        <div class="quote-card__row">
          <input
            id="footer-phone"
            type="tel"
            name="phone"
            autocomplete="tel"
            inputmode="tel"
            placeholder="Your mobile number"
            required
          />
          <button type="submit" class="quote-card__btn">Text Me A Quote</button>
        </div>
        <p class="quote-card__micro">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 11-14h-7l1-6Z"/></svg>
          Adam will reply personally.
        </p>
      </form>
    </div>

    <footer>
      <p>Working for love and money.</p>
      <p>© 2026 Weekend Tree Surgeon</p>
    </footer>
  </div>
</section>
</BaseLayout>
