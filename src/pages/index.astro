---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import founderPhoto from "../assets/images/founder-headshot.webp";
---

<BaseLayout
  title="Tree Surgery in Nantwich & Crewe"
  description="Professional tree surgery and hedge cutting for homeowners in Nantwich, Crewe and surrounding Cheshire areas."
>
<section class="hero" id="hero">
  <div class="hero__inner">

    
    <div class="hero__intro">
      <div class="hero__photo">
        <!-- Replace with the real headshot -->
        <img src="assets/images/headshot.jpg" alt="[Your Name], founder of Local Tree Care">
      </div>
      <p class="hero__greeting">
        Adam - The Weekend Tree Surgeon
        <span>I'll be the one at your door</span>
      </p>
    </div>
    
    <div class="hero__badges">
      <span class="badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3Z"/></svg>
        Cheshire
      </span>
      <span class="badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9 12 3l9 6v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V9Z"/></svg>
        Hedges
      </span>
      <span class="badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9 12 3l9 6v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V9Z"/></svg>
        Trees
      </span>
    </div>

    <h1 class="hero__title">The tree service that actually shows up on time.</h1>
    <!-- <p class="hero__subtitle">Professional tree and hedge trimming and removal for homeowners tired of typical tradesman headaches. No ghosting, no surprise pricing, zero property damage.</p> -->

    <form name="hero-quote" method="POST" data-netlify="true" name="phone number" class="quote-card hero__quote">
      <p class="quote-card__label">Where should I text your quick estimate?</p>
      <div class="quote-card__row">
        <input type="tel" inputmode="tel" placeholder="Enter your mobile number" autocomplete="tel" aria-label="Mobile number">
        <button type="button" class="quote-card__btn">Text Me A Quote</button>
      </div>
      <p class="quote-card__micro">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 11-14h-7l1-6Z"/></svg>
        Usually responds in 15 minutes
      </p>
    </div>

  </div>
</section>

  <!-- Testimonials -->
  <section class="testimonials">
    <div class="page-wrap">
      <span class="section-label">What some lovely people have to say about WTS</span>

      <div class="testimonial-grid">
        <article class="testimonial-card">
          <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
          <p>
            “Adam is one of the good ones. He was friendly, helpful and very
            professional. I would recommend him to anyone looking for a tree
            surgeon.”
          </p>
          <span>Rebecca T.</span>
        </article>

        <article class="testimonial-card">
          <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
          <p>
            “Adam was great. He came out on a Saturday morning and was very
            friendly and helpful. We'd recommend him to anyone looking for a
            tree surgeon.”
          </p>
          <span>Alwena B.</span>
        </article>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services">
    <div class="page-wrap">
      <span class="section-label">How I can help</span>
      <h2>Tree work without the usual hassle.</h2>

      <div class="service-grid">

        <article class="service-card">
          <div class="service-icon" aria-hidden="true">01</div>
          <h3>The “Get Your Sunlight Back”</h3>
          <p>
            Reduce overgrown trees, branches and boughs, so your garden feels lighter,
            tidier and more enjoyable again.
          </p>
        </article>

        <article class="service-card">
          <div class="service-icon" aria-hidden="true">02</div>
          <h3>The “Tidy Up My Hedges”</h3>
          <p>
            Expertly trim to a fine finish, or heavily cut back your boundary hedges. Including those hard to reach tops. 
          </p>
        </article>

        <article class="service-card">
          <div class="service-icon" aria-hidden="true">03</div>
          <h3>The “It's time to say goodbye”</h3>
          <p>
           A tree that needs felling or dismantling? I'll do it quickly and leave your garden
            safe and properly cleared afterwards.
          </p>
        </article>
      </div>
      <!-- inside .services, directly after the 3-card grid, before the wrap closes -->
      <div class="services__all"> 
        <p class="services__all-label">I also cover <i>(...so you find me on Google 😎)</i>:</p>
        <div class="services__all-list">
          <span class="trait">Pollarding</span>
          <span class="trait">Deadwooding</span>
          <span class="trait">Stump removal</span>
          <span class="trait">Hedge cutting</span>
          <span class="trait">Garden clearance</span>
      </div>
</div>
    </div>
  </section>

