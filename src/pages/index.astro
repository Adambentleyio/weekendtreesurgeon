---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, Picture } from "astro:assets";
import { getCollection } from "astro:content";
import founderPhoto from "../assets/images/founder-headshot.webp";
import adamProfile from "../assets/images/adam-profile.jpg";
import climbingPhoto from "../assets/images/dismantle.jpg";
import client from "../data/client.json";

const recentProjects = (await getCollection("recentWork"))
  .filter(({ data }) => data.featuredOrder)
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999))
  .slice(0, 3);
---

<BaseLayout
  title="Tree Surgery in Nantwich & Crewe"
  description="Professional tree surgery and hedge cutting for homeowners in Nantwich, Crewe and surrounding Cheshire areas."
  showNav="true"
  >
<section class="hero" id="hero">
  <div class="hero__inner">
    <div class="hero__content">
      <div class="hero__intro">
        <Image class="hero__photo" src={adamProfile} alt="Adam Bentley, the Weekend Tree Surgeon" width={96} height={96} format="webp" quality={82} loading="eager" />
        <p class="hero__greeting">
          Hi, I’m Adam
          <span>Wistaston and Nantwich-based Tree Surgeon</span>
        </p>
      </div>

      <h1 class="hero__title">Your garden, cared for properly.</h1>

      <div class="hero-reviews" aria-label="Recent customer reviews on Google">
        <div class="hero-reviews__heading">
          <span class="hero-reviews__stars" aria-label="5 out of 5 stars">★★★★★</span>
          <a href={client.googleBusinessUrl}>Real words from customers on Google <span aria-hidden="true">↗</span></a>
        </div>
        <blockquote class="hero-reviews__lead">
          <p>“Thanks Adam. 5 stars is not enough, you deserve a gold star.”</p>
        </blockquote>
      </div>

      <form name="hero-quote" method="POST" data-netlify="true" class="quote-card hero__quote">
        <input type="hidden" name="form-name" value="hero-quote" />
        <div class="quote-card__row">
          <input id="hero-phone" type="tel" name="phone" inputmode="tel" placeholder="Your mobile number" autocomplete="tel" aria-label="Your mobile number" required>
          <button type="submit" class="quote-card__btn">Request a quote</button>
        </div>
        <p class="hero__contact-options">
          Rather talk? <a href={`tel:${client.phoneForTel}`}>Call {client.phoneFormatted}</a>
          <span aria-hidden="true">·</span>
          <a href="/contact">Tell me about the job</a>
        </p>
      </form>
    </div>
    <div class="hero__media">
      <Picture
        src={climbingPhoto}
        formats={["avif", "webp"]}
        widths={[320, 480, 640, 800]}
        sizes="(min-width: 1200px) 34vw, (min-width: 768px) 38vw, 100vw"
        alt="Adam working from ropes while reducing a tree in a Cheshire garden"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

  <section class="recent-work" id="recent-work" aria-labelledby="recent-work-title">
    <div class="page-wrap">
      <span class="section-label">Recent work around Cheshire</span>
      <h2 id="recent-work-title">See the problem, the work and how the garden was left.</h2>
      <div class="recent-work__grid">
        {recentProjects.map(({ id, data: project }, index) => (
          <article class:list={["project-card", { "project-card--featured": index === 0 }]}>
            <a class="project-card__image" href={`/recent-work/${id}`} aria-label={`Read ${project.card.title}`}>
              <Image src={project.card.image} alt={project.card.alt} widths={[480, 768, 1120]} sizes={index === 0 ? "(min-width: 768px) 55vw, 100vw" : "(min-width: 768px) 35vw, 100vw"} format="avif" quality={78} loading="lazy" />
            </a>
            <div class="project-card__body">
              <p class="project-card__meta">{project.serviceLabel} <span aria-hidden="true">·</span> {project.location}</p>
              <h3>{project.card.title}</h3>
              <p>{project.card.summary}</p>
              <a class="project-card__link" href={`/recent-work/${id}`}>Read the project <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <div class="recent-work__actions">
        <a class="recent-work__primary" href="/contact">Get a quote for your garden</a>
        <a class="recent-work__secondary" href="#services">See all services</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="services">
    <div class="page-wrap">
      <span class="section-label">How I can help</span>
      <h2>Tree work without the usual hassle.</h2>

      <nav class="service-list" aria-label="Tree and garden services">
        <a href="/box-hedge-blight-removal"><span>Box hedge blight removal</span><small>Remove failed box and prepare the border for replacement planting</small><b aria-hidden="true">→</b></a>
        <a href="/services/hedge-cutting"><span>Hedge cutting</span><small>Trim, shape or reduce overgrown hedges</small><b aria-hidden="true">→</b></a>
        <a href="/services/tree-removal"><span>Tree removal</span><small>Careful removal where a tree cannot be retained</small><b aria-hidden="true">→</b></a>
        <a href="/services/hedge-removal"><span>Hedge removal</span><small>Remove unwanted hedges and reclaim space</small><b aria-hidden="true">→</b></a>
        <a href="/services/garden-maintenance"><span>Garden maintenance</span><small>Tidy established gardens back into shape</small><b aria-hidden="true">→</b></a>
        <a href="/services/crown-reduction"><span>Crown reduction</span><small>Reduce the height or spread of a suitable tree</small><b aria-hidden="true">→</b></a>
        <a href="/services/pollarding"><span>Pollarding</span><small>Manage suitable trees on a planned pruning cycle</small><b aria-hidden="true">→</b></a>
        <a href="/services/tree-pruning"><span>Tree pruning</span><small>Selective pruning for clearance, shape and unwanted growth</small><b aria-hidden="true">→</b></a>
      </nav>
    </div>
  </section>

  <!-- Gallery -->
