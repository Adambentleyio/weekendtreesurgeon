---
import BaseLayout from "../layouts/BaseLayout.astro";
import client from "../data/client.json";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Adam at Weekend Tree Surgeon for tree surgery, hedge cutting and garden clearance in Nantwich and Crewe."
>
  <section id="cs-contact">
    <div class="cs-container">
      <form id="cs-form" name="Contact Form" method="post" netlify>
        <input type="hidden" name="form-name" value="Contact Form" />
        <div class="cs-content">
          <span class="cs-topper">Contact</span>
          <h2 class="cs-title">Get in Touch</h2>
          <p class="cs-text">
            Feel free to call, text or fill out the form below. I respond to all messages by the end of each day. Looking forward to hearing from you!
          </p>
        </div>
        <label>
          Name
          <input
            required
            type="text"
            id="name"
            name="name"
            placeholder="Name"
          />
        </label>
        <label>
          Email
          <input
            required
            type="email"
            id="email"
            name="email"
            placeholder="Email"
          />
        </label>
        <label>
          Phone
          <input
            required
            type="tel"
            id="phone"
            name="phone"
            placeholder="Phone"
          />
        </label>
        <label>
          How Did You Find Us
          <input
            type="text"
            id="find"
            name="find-us"
            placeholder="How did you find us?"
          />
        </label>
        <label class="cs-label-message">
          Message
          <textarea
            required
            name="Message"
            id="message"
            placeholder="Write message..."></textarea>
        </label>
        <button class="btn" type="submit">Submit Message</button>
      </form>

      <div class="cs-right-section">
        <div class="cs-bg-picture">
          <!-- Replace with the real photo: <img src="/images/adam-climbing.jpg" alt="Adam mid-climb, working on a tree"> -->
          <img src="assets/images/dismantle.jpg" alt="Adam mid-climb, working on a tree">
        </div>
        <span class="cs-header">Real work, done properly</span>
        <a href="/#gallery" class="cs-link">See more finished jobs →</a>
      </div>
    </div>
  </section>

  <footer>
    <p>Working for love and money.</p>
    <p>© 2026 Weekend Tree Surgeon</p>
  </footer>
</BaseLayout>

<style lang="less">

  footer {
    display: flex;
    flex-direction: column;
    background: var(--forest);
    color: var(--sage);
    justify-content: center;
    align-items: center;
    padding: var(--section-padding);
  }

  /* PAGE-SPECIFIC STYLES FOR THE CONTACT PAGE */

  /* Mobile - 360px */
  @media only screen and (min-width: 0em) {
    :root {
      --topperFontSize: clamp(0.8125rem, 1.6vw, 1rem);
      --headerFontSize: clamp(1.9375rem, 4.5vw, 3.0625rem);
      --bodyFontSize: 1rem;
      --sectionPadding: clamp(3.75em, 7.82vw, 6.25em) 1rem;
    }

    #cs-contact {
      font-family: var(--font-body);
      padding: var(--sectionPadding);
      margin-block: (40/16rem);

      .cs-container {
        width: 100%;
        max-width: (800/16rem);
        margin: auto;
      }

      .cs-content {
        width: 100%;
      }

      .cs-topper {
        display: block;
        color: #8C5A22;
        font-weight: 700;
      
        font-size: 0.78rem;
        text-transform: none;
        text-align: left;
        margin-bottom: clamp(0.5rem, 1.4vw, 0.75rem);
      }

      .cs-title {
        font-family: var(--font-heading);
        color: var(--forest);
        text-align: left;
        max-width: (800/16rem);
      }

      .cs-text {
        color: var(--charcoal-soft);
        text-align: left;
        max-width: clamp(25.25rem, 30vw, 32.625rem);
        margin: 0 auto 0 0;
        margin-bottom: clamp(2.5rem, 6.3vw, 3rem);
      }

      #cs-form {
        margin-bottom: (40/16rem);

        label {
          font-size: (16/16rem);
          line-height: 1.5em;
          margin-bottom: clamp(0.75rem, 1.3em, 1.25rem);
          color: var(--forest);
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;
        }

        .cs-label-message {
          margin-bottom: clamp(2rem, 6.3vw, 3rem);
        }

        input,
        textarea {
          font-family: var(--font-body);
          font-size: (16/16rem);
          width: 100%;
          height: (64/16rem);
          margin-top: (4/16rem);
          box-sizing: border-box;
          padding-left: (20/16rem);
          background: var(--sage-lighter);
          color: var(--charcoal);
          border: 1px solid var(--line);
          border-radius: (8/16rem);
          transition: border-color 0.3s;

          &:hover,
          &:focus {
            border-color: var(--sage);
            outline: none;
          }
        }

        textarea {
          font-family: inherit;
          min-height: (120/16rem);
          padding-top: (20/16rem);
        }

        .btn {
          width: 100%;
          background: var(--gold);
          color: var(--white);
          border: none;
          border-radius: (12/16rem);
          padding: (16/16rem) (18/16rem);
          // font-weight: 700;
          font-size: (16/16rem);
          cursor: pointer;
          transition: background 0.15s ease;

          &:hover {
            background: #B67A31;
          }
        }
      }

      .cs-right-section {
        display: none; // hidden on mobile, switched on at desktop below
        height: (320/16rem);
        padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 3vw, 2.5rem);
        border-radius: (8/16rem);
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-start;
        position: relative;
        overflow: hidden;
      }

      .cs-header {
        font-family: var(--font-heading);
        font-size: clamp(1rem, 3vw, 1.25rem);
        line-height: 1.2em;
        margin-bottom: (8/16rem);
        color: var(--white);
        display: block;
      }

      .cs-link {
        font-size: clamp(1rem, 3vw, 1.25rem);
        line-height: 1.2em;
        text-decoration: none;
        margin-bottom: (20/16rem);
        color: var(--white);
        display: block;
        position: relative;

        &:before {
          content: "";
          width: 0%;
          height: 2px;
          background: currentColor;
          opacity: 1;
          display: block;
          position: absolute;
          bottom: (-2/16rem);
          left: 0;
          transition: width 0.3s;
        }

        &:hover:before {
          width: 100%;
        }

        &:last-of-type {
          margin-bottom: 0;
        }
      }

      .cs-bg-picture {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        transition: transform 0.6s;

        &:before {
          content: "";
          width: 100%;
          height: 100%;
          background: linear-gradient(
            180deg,
            rgba(21, 42, 32, 0) 0%,
            rgba(21, 42, 32, 0.85) 100%
          );
          display: block;
          position: absolute;
          top: 0;
          left: 0;
          z-index: 1;
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          position: absolute;
          top: 0;
          left: 0;
        }
      }

      .cs-photo-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sage-light);

        svg {
          width: 64px;
          height: 64px;
          color: var(--sage);
        }
      }
    }
  }

  /* Tablet - 700px */
  @media only screen and (min-width: 43.75em) {
    #cs-contact {
      #cs-form {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;

        label {
          width: 48%;
        }

        .cs-label-message {
          width: 100%;
        }
      }
    }
  }

  /* Small Desktop - 1024px */
  @media only screen and (min-width: 64em) {
    #cs-contact {
      .cs-container {
        max-width: (1280/16rem);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: (80/16rem);
      }

      #cs-form {
        max-width: (630/16rem);
        label {
          width: 100%;
        }
      }

      .cs-right-section {
        display: flex; // photo turns on here
        width: 40%;
        max-width: (542/16rem);
        height: (686/16rem);
        flex: none;

        &:hover {
          .cs-bg-picture {
            transform: scale(1.1);
          }
        }
      }
    }
  }

  /* Small Desktop - 1300px */
  @media only screen and (min-width: 81.25em) {
    #cs-contact {
      #cs-form {
        column-gap: (0/16rem);
        label {
          width: 48%;
          max-width: (305/16rem);
        }

        .cs-label-message {
          max-width: 100%;
        }
      }

      .cs-right-section {
        height: (578/16rem);
      }
    }
  }
</style>