---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";

const projects = (await getCollection("recentWork"))
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));
---

<BaseLayout title="Recent Tree and Garden Work in Cheshire" description="Browse genuine tree surgery, hedge and garden projects completed around Nantwich, Crewe and nearby Cheshire villages." showNav={true} navCtaHref="/contact">
  <section class="work-index" aria-labelledby="work-title">
    <div class="page-wrap">
      <p class="section-label">Genuine local projects</p>
      <h1 id="work-title">Recent work around Cheshire</h1>
      <p class="work-index__intro">See the original problem, what Adam did and how each garden was left.</p>
      <div class="work-index__grid">
        {projects.map(({ id, data }) => (
          <article class="work-card">
            <a class="work-card__image" href={`/recent-work/${id}`} aria-label={`Read ${data.card.title}`}>
              <Image src={data.card.image} alt={data.card.alt} widths={[480, 720, 960]} sizes="(min-width:760px) 50vw, 100vw" format="webp" quality={78} loading="lazy" />
            </a>
            <div class="work-card__body">
              <p class="work-card__meta">{data.serviceLabel} <span aria-hidden="true">·</span> {data.location}</p>
              <h2>{data.card.title}</h2>
              <p>{data.card.summary}</p>
              <a class="work-card__link" href={`/recent-work/${id}`}>Read the project <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>

<style lang="less">
  .work-index{padding-block:clamp(3.5rem,8vw,7rem);background:var(--cream)}.work-index h1{max-width:14ch;font-size:clamp(2.5rem,6vw,4.8rem);line-height:1.02}.work-index__intro{max-width:42rem;margin-top:1rem;color:var(--charcoal-soft);font-size:clamp(1.05rem,2vw,1.25rem)}.work-index__grid{display:grid;gap:1.25rem;margin-top:clamp(2.5rem,6vw,4.5rem)}.work-card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:var(--sage-lighter)}.work-card__image{display:block;overflow:hidden;aspect-ratio:16/10;background:var(--sage-light)}.work-card__image :global(picture),.work-card__image :global(img){width:100%;height:100%}.work-card__image :global(img){object-fit:cover;transition:transform 350ms cubic-bezier(.22,1,.36,1)}.work-card__image:hover :global(img){transform:scale(1.025)}.work-card__body{padding:1.4rem}.work-card__meta{margin-bottom:.5rem;color:var(--sage);font-size:.78rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.work-card h2{margin-bottom:.5rem;font-size:1.4rem}.work-card__body>p:not(.work-card__meta){color:var(--charcoal-soft)}.work-card__link{display:inline-block;margin-top:1rem;color:var(--forest);font-weight:700;text-underline-offset:.25rem}@media(min-width:760px){.work-index__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(prefers-reduced-motion:reduce){.work-card__image :global(img){transition:none}.work-card__image:hover :global(img){transform:none}}
</style>
